#!/usr/bin/env python3
"""h — budget-aware model router for Hermes Agent, across any provider.

Picks the cheapest model tier that fits a task (one tiny classifier call, keyword
fallback offline), checks this cycle's spend from Hermes' own state.db, logs the
decision, then launches `hermes chat` with that provider and model. Tiers can mix
providers: e.g. local Ollama for quick tasks, Gemini for routine work, Claude for hard ones.

Usage:
  h <task>              route the task, then launch Hermes
  h                     prompt for the task
  h -q|-s|-o <task>     force the quick / standard / strong tier
  h -n <task>           dry run: show the decision, don't launch
  h --init <preset>     write ~/.hermes/h.json from a preset (see --presets)
  h --presets           list bundled presets
  h --check             verify keys and that each tier's model exists at its provider
  h --budget            this cycle's estimated spend and pace
  h --sessions [N] [--csv] [--titles] [--schema]
                        last N Hermes sessions with tokens, tool calls and estimated cost
                        (from Hermes' state.db; titles hidden unless --titles)
  h --stats             summarise past routing decisions
  h --eval FILE         route each line of FILE (dry run), print CSV for labelling
  h --score FILE.csv    accuracy of a labelled eval CSV
  h --version | --help

Config: ~/.hermes/h.json (or $H_CONFIG). Without one, the built-in default is the
"claude-credits" preset. Each tier may set "reasoning" (none..ultra) → hermes --reasoning.
Env: H_PAUSE, H_FIRST_MESSAGE_FLAG (default -q; "clipboard" for old Hermes), H_LOG_TASKS=0, H_DEBUG=1.
"""
from __future__ import annotations

import csv
import datetime as dt
import json
import logging
import os
import re
import shutil
import sqlite3
import subprocess
import sys
import time
import urllib.error
import urllib.request
from dataclasses import asdict, dataclass, field
from pathlib import Path

__version__ = "0.3.1"

HERMES_HOME = Path(os.environ.get("HERMES_HOME", Path.home() / ".hermes"))
ENV_FILE = HERMES_HOME / ".env"
STATE_DB = HERMES_HOME / "state.db"
LOG_FILE = HERMES_HOME / "h-routing.jsonl"
CONFIG_FILE = Path(os.environ.get("H_CONFIG", HERMES_HOME / "h.json"))
PRESET_DIRS = [Path(__file__).resolve().parent.parent / "presets",
               Path.home() / ".local" / "share" / "h" / "presets"]
TIERS = ("q", "s", "o")
TIER_NAMES = {"q": "quick", "s": "standard", "o": "strong"}
REASONING_LEVELS = {"none", "minimal", "low", "medium", "high", "xhigh", "max", "ultra"}

# How h talks to each Hermes provider id for classification and --check.
# "api": "anthropic" = Messages API; "openai" = OpenAI-compatible /chat/completions.
# Providers missing here (subscription sign-ins like openai-codex, xai-oauth, copilot)
# can still be launched; they just can't run the classifier.
ENDPOINTS: dict[str, dict] = {
    "anthropic":  {"api": "anthropic", "base_url": "https://api.anthropic.com/v1", "key_env": ["ANTHROPIC_API_KEY"]},
    "openai-api": {"api": "openai", "base_url": "https://api.openai.com/v1", "key_env": ["OPENAI_API_KEY"]},
    "gemini":     {"api": "openai", "base_url": "https://generativelanguage.googleapis.com/v1beta/openai",
                   "key_env": ["GEMINI_API_KEY", "GOOGLE_API_KEY"]},
    "xai":        {"api": "openai", "base_url": "https://api.x.ai/v1", "key_env": ["XAI_API_KEY"]},
    "openrouter": {"api": "openai", "base_url": "https://openrouter.ai/api/v1", "key_env": ["OPENROUTER_API_KEY"]},
    "deepseek":   {"api": "openai", "base_url": "https://api.deepseek.com/v1", "key_env": ["DEEPSEEK_API_KEY"]},
    "custom":     {"api": "openai", "base_url": "http://localhost:11434/v1", "key_env": []},
}

DEFAULT_CONFIG: dict = {
    "name": "claude-credits (built-in default)",
    "budget_usd": 200,
    "cycle_day": 10,
    "classifier_tier": "q",
    "tiers": {
        "q": {"label": "Haiku", "provider": "anthropic", "model": "claude-haiku-5-5"},
        "s": {"label": "Sonnet", "provider": "anthropic", "model": "claude-sonnet-5-5"},
        "o": {"label": "Opus", "provider": "anthropic", "model": "claude-opus-5-5"},
    },
}

HEAVY = re.compile(
    r"\b(architect\w*|design|strateg\w*|review|debug|refactor|deck|proposal|policy|"
    r"governance|trade-?offs?|migrat\w*|compare|build)\b",
    re.IGNORECASE,
)

SYSTEM_PROMPT = """You route tasks to the cheapest AI model tier that will do them well.
q = quick: definitions, quick facts, lookups, short summaries, simple rewrites, formatting.
s = standard: routine coding and edits, drafts, emails, multi-step but well-defined work, and plans or advice drawn from general knowledge (how-tos, frameworks, generic improvement plans).
o = strong: decisions with real stakes or that hinge on the user's specific situation, architecture and design trade-offs, hard debugging, long builds, documents going to stakeholders or the public, genuinely novel or ambiguous problems.
When unsure between two tiers, pick the cheaper one.{budget_hint}
Reply with JSON only: {{"tier":"q|s|o","reason":"<max 12 words>"}}"""

BUDGET_HINTS: dict[str, str] = {
    "tight": "\nBudget is on pace to run out early: only choose o when the task clearly needs it.",
    "underuse": "\nUnused credit expires soon: when torn between two tiers, choose the stronger one.",
}

log = logging.getLogger("h")


# ================================================================ config
@dataclass
class Tier:
    key: str
    provider: str
    model: str
    label: str = ""
    reasoning: str = ""

    @property
    def name(self) -> str:
        return self.label or f"{TIER_NAMES[self.key]} ({self.provider})"


@dataclass
class Config:
    name: str
    tiers: dict[str, Tier]
    budget_usd: float | None = 200
    cycle_day: int = 10
    classifier_tier: str = "q"
    endpoints: dict[str, dict] = field(default_factory=dict)

    def endpoint(self, provider: str) -> dict | None:
        """User-defined endpoint overrides the built-in table."""
        return self.endpoints.get(provider) or ENDPOINTS.get(provider)


def parse_config(raw: dict) -> Config:
    """Validate a config dict and build a Config. Raises ValueError on bad input."""
    tiers_raw = raw.get("tiers") or {}
    missing = [t for t in TIERS if t not in tiers_raw]
    if missing:
        raise ValueError(f"config is missing tiers: {', '.join(missing)}")
    tiers: dict[str, Tier] = {}
    for key in TIERS:
        t = tiers_raw[key]
        if not t.get("provider") or not t.get("model"):
            raise ValueError(f"tier '{key}' needs both 'provider' and 'model'")
        if "REPLACE" in str(t["model"]).upper():
            raise ValueError(f"tier '{key}' still has a placeholder model: {t['model']}")
        reasoning = str(t.get("reasoning", "") or "").lower()
        if reasoning and reasoning not in REASONING_LEVELS:
            raise ValueError(f"tier '{key}' reasoning must be one of {', '.join(sorted(REASONING_LEVELS))}")
        tiers[key] = Tier(key, t["provider"], t["model"], t.get("label", ""), reasoning)
    classifier = raw.get("classifier_tier", "q")
    if classifier not in TIERS:
        raise ValueError("classifier_tier must be q, s or o")
    budget = raw.get("budget_usd", 200)
    return Config(
        name=raw.get("name", "custom"),
        tiers=tiers,
        budget_usd=float(budget) if budget not in (None, 0, "") else None,
        cycle_day=int(raw.get("cycle_day", 10)),
        classifier_tier=classifier,
        endpoints=raw.get("endpoints", {}),
    )


def load_config(path: Path = CONFIG_FILE) -> Config:
    """Load ~/.hermes/h.json, or the built-in Claude default if it doesn't exist."""
    if not path.exists():
        return parse_config(DEFAULT_CONFIG)
    try:
        return parse_config(json.loads(path.read_text()))
    except (json.JSONDecodeError, ValueError) as exc:
        raise SystemExit(f"h: bad config {path}: {exc}")


def find_presets() -> dict[str, Path]:
    presets: dict[str, Path] = {}
    for d in PRESET_DIRS:
        if d.is_dir():
            for p in sorted(d.glob("*.json")):
                presets.setdefault(p.stem, p)
    return presets


# ================================================================ keys & HTTP
def read_env_file(path: Path = ENV_FILE) -> dict[str, str]:
    """Parse KEY=VALUE lines from Hermes' .env (ignores comments and blanks)."""
    values: dict[str, str] = {}
    try:
        for line in path.read_text().splitlines():
            line = line.strip()
            if not line or line.startswith("#") or "=" not in line:
                continue
            k, v = line.split("=", 1)
            v = v.strip().strip('"').strip("'")
            if v:
                values[k.strip()] = v
    except OSError as exc:
        log.debug("Could not read %s: %s", path, exc)
    return values


def get_key(endpoint: dict, env_file: dict[str, str] | None = None) -> str | None:
    """Return the first available key for an endpoint from env or .env. '' if none needed."""
    names = endpoint.get("key_env", [])
    if isinstance(names, str):
        names = [names]
    if not names:
        return ""
    env_file = env_file if env_file is not None else read_env_file()
    for n in names:
        if os.environ.get(n):
            return os.environ[n]
        if env_file.get(n):
            return env_file[n]
    return None


def _http_json(url: str, headers: dict, body: dict | None = None, timeout: int = 15) -> dict:
    data = json.dumps(body).encode() if body is not None else None
    req = urllib.request.Request(url, data=data, method="POST" if body is not None else "GET",
                                 headers={"content-type": "application/json", **headers})
    with urllib.request.urlopen(req, timeout=timeout) as resp:
        return json.load(resp)


def _auth_variants(endpoint: dict, key: str) -> list[dict]:
    if endpoint["api"] == "anthropic":
        base = {"anthropic-version": "2023-06-01"}
        # Hermes labels newer sk-ant-usr keys as OAuth; try both header styles.
        return [{**base, "x-api-key": key}, {**base, "authorization": f"Bearer {key}"}]
    return [{"authorization": f"Bearer {key}"}] if key else [{}]


def chat(endpoint: dict, key: str, model: str, system: str, user: str, max_tokens: int = 60) -> str | None:
    """Single-turn completion via the endpoint's API style. Returns text or None."""
    base = endpoint["base_url"].rstrip("/")
    for headers in _auth_variants(endpoint, key):
        try:
            if endpoint["api"] == "anthropic":
                data = _http_json(f"{base}/messages", headers, {
                    "model": model, "max_tokens": max_tokens, "system": system,
                    "messages": [{"role": "user", "content": user}]})
                return "".join(b.get("text", "") for b in data.get("content", []) if b.get("type") == "text")
            data = _http_json(f"{base}/chat/completions", headers, {
                "model": model, "max_tokens": max_tokens,
                "messages": [{"role": "system", "content": system}, {"role": "user", "content": user}]})
            return data["choices"][0]["message"]["content"] or ""
        except urllib.error.HTTPError as exc:
            log.debug("HTTP %s from %s (%s)", exc.code, base, ",".join(headers))
            if exc.code in (401, 403) and endpoint["api"] == "anthropic":
                continue
            return None
        except (urllib.error.URLError, TimeoutError, json.JSONDecodeError, KeyError, IndexError) as exc:
            log.debug("Request to %s failed: %s", base, exc)
            return None
    return None


def list_models(endpoint: dict, key: str) -> set[str] | None:
    """Model IDs the provider reports via GET /models. None if it can't be read."""
    base = endpoint["base_url"].rstrip("/")
    for headers in _auth_variants(endpoint, key):
        try:
            data = _http_json(f"{base}/models", headers)
        except urllib.error.HTTPError as exc:
            log.debug("GET /models HTTP %s from %s", exc.code, base)
            if exc.code in (401, 403) and endpoint["api"] == "anthropic":
                continue
            return None
        except (urllib.error.URLError, TimeoutError, json.JSONDecodeError) as exc:
            log.debug("GET /models failed: %s", exc)
            return None
        ids = set()
        for m in data.get("data", []) or data.get("models", []):
            mid = str(m.get("id") or m.get("name") or "")
            ids.add(mid)
            ids.add(mid.removeprefix("models/"))
        return ids
    return None


# ================================================================ budget
@dataclass
class Budget:
    """Estimated spend for the current cycle, from Hermes' own cost estimates."""
    spent: float
    budget: float
    cycle_start: dt.date
    cycle_end: dt.date
    today: dt.date

    @property
    def days_elapsed(self) -> int:
        return max((self.today - self.cycle_start).days, 1)

    @property
    def days_total(self) -> int:
        return max((self.cycle_end - self.cycle_start).days, 1)

    @property
    def days_left(self) -> int:
        return max((self.cycle_end - self.today).days, 0)

    @property
    def projected(self) -> float:
        return self.spent / self.days_elapsed * self.days_total

    @property
    def status(self) -> str:
        if self.days_left <= 5 and (self.budget - self.spent) > 0.25 * self.budget:
            return "underuse"
        if self.projected > self.budget:
            return "tight"
        return "normal"

    def line(self) -> str:
        pct = 100 * self.spent / self.budget if self.budget else 0
        msg = (f"cycle ~${self.spent:.2f} of ${self.budget:.0f} ({pct:.0f}%) · "
               f"{self.days_left}d left · pace ~${self.projected:.0f}")
        return msg + {"tight": " · ⚠ on pace to run out", "underuse": " · unused budget expiring",
                      "normal": ""}[self.status]


def cycle_bounds(today: dt.date, cycle_day: int) -> tuple[dt.date, dt.date]:
    """Return (start, end) of the cycle containing `today`, anchored on `cycle_day`."""
    def anchor(year: int, month: int) -> dt.date:
        for d in (cycle_day, 30, 29, 28):
            try:
                return dt.date(year, month, d)
            except ValueError:
                continue
        raise ValueError("bad cycle day")

    this = anchor(today.year, today.month)
    if today >= this:
        start, (y, m) = this, (today.year + (today.month == 12), today.month % 12 + 1)
        return start, anchor(y, m)
    y, m = today.year - (today.month == 1), (today.month - 2) % 12 + 1
    return anchor(y, m), this


def _to_date(value: object) -> dt.date | None:
    if value is None:
        return None
    try:
        num = float(value)  # type: ignore[arg-type]
        return dt.datetime.fromtimestamp(num / 1000 if num > 1e12 else num).date()
    except (TypeError, ValueError, OverflowError, OSError):
        pass
    try:
        return dt.datetime.fromisoformat(str(value).replace("Z", "+00:00")).date()
    except ValueError:
        return None


def read_budget(cfg: Config, db: Path = STATE_DB, today: dt.date | None = None) -> Budget | None:
    """Sum Hermes' estimated_cost_usd for sessions in the current cycle. None if unavailable."""
    if not cfg.budget_usd:
        return None
    today = today or dt.date.today()
    start, end = cycle_bounds(today, cfg.cycle_day)
    if not db.exists():
        log.debug("No state.db at %s", db)
        return None
    try:
        con = sqlite3.connect(f"file:{db}?mode=ro", uri=True, timeout=2)
        cols = [r[1] for r in con.execute("PRAGMA table_info(sessions)")]
        time_col = next((c for c in ("started_at", "created_at", "start_time", "updated_at", "timestamp")
                         if c in cols), None)
        if "estimated_cost_usd" not in cols or time_col is None:
            log.debug("Unexpected sessions schema: %s", cols)
            con.close()
            return None
        rows = con.execute(f"SELECT {time_col}, estimated_cost_usd FROM sessions").fetchall()
        con.close()
    except sqlite3.Error as exc:
        log.debug("state.db read failed: %s", exc)
        return None
    spent = sum(float(c or 0) for t, c in rows if (d := _to_date(t)) and start <= d <= today)
    return Budget(spent, cfg.budget_usd, start, end, today)


# ================================================================ session evidence
# Columns worth showing, in display order, with short headers. Matched exactly against Hermes'
# sessions table (v0.23 schema); anything else (prompts, chat ids, JSON blobs) is never printed.
SESSION_COLUMNS: list[tuple[str, str]] = [
    ("id", "session"), ("started_at", "started"), ("model", "model"),
    ("message_count", "msgs"), ("api_call_count", "api_calls"), ("tool_call_count", "tools"),
    ("input_tokens", "in_tok"), ("output_tokens", "out_tok"),
    ("cache_read_tokens", "cache_rd"), ("cache_write_tokens", "cache_wr"), ("reasoning_tokens", "reason_tok"),
    ("estimated_cost_usd", "hermes_est_usd"), ("actual_cost_usd", "actual_usd"), ("cost_status", "status"),
]

# Published list prices, USD per million tokens: input, output, 5-minute cache write, cache read.
# Source: https://platform.claude.com/docs/en/about-claude/pricing (Nov 2026). Haiku: prompts up to 100K tokens.
# Used only to recompute Hermes' estimate independently; extend for other providers' models.
PRICES: dict[str, tuple[float, float, float, float]] = {
    "claude-opus-5-5": (4.00, 20.00, 5.00, 0.20),
    "claude-sonnet-5-5": (2.00, 10.00, 2.50, 0.10),
    "claude-haiku-5-5": (0.10, 0.50, 0.125, 0.01),
}


def recompute_cost(model: str, tokens: dict[str, float]) -> float | None:
    """Cost from token counts x published prices. None if the model isn't in PRICES.
    Assumes 5-minute cache writes; reasoning tokens are billed as output and are assumed to be
    included in output_tokens (if Hermes counts them separately, this under-counts them)."""
    p = PRICES.get(model)
    if not p:
        return None
    g = lambda k: float(tokens.get(k) or 0)
    return (g("input_tokens") * p[0] + g("output_tokens") * p[1]
            + g("cache_write_tokens") * p[2] + g("cache_read_tokens") * p[3]) / 1_000_000


def read_sessions(db: Path = STATE_DB, limit: int = 10, titles: bool = False) -> tuple[list[str], list[tuple]]:
    """Return (headers, rows) for the most recent sessions, newest first, plus a 'recomputed_usd'
    column. Only whitelisted columns are read; titles only with titles=True."""
    if not db.exists():
        raise SystemExit(f"h: no Hermes database at {db}")
    con = sqlite3.connect(f"file:{db}?mode=ro", uri=True, timeout=2)
    try:
        available = {r[1] for r in con.execute("PRAGMA table_info(sessions)")}
        if not available:
            raise SystemExit("h: state.db has no sessions table")
        wanted = list(SESSION_COLUMNS)
        if titles:
            wanted.insert(3, ("title", "title"))
        cols = [(c, hdr) for c, hdr in wanted if c in available]
        order = next((c for c in ("started_at", "created_at", "start_time") if c in available), "rowid")
        quoted = ", ".join(f'"{c}"' for c, _ in cols)
        raw = con.execute(f"SELECT {quoted} FROM sessions ORDER BY {order} DESC LIMIT ?", (limit,)).fetchall()
    finally:
        con.close()
    names = [c for c, _ in cols]
    headers = [hdr for _, hdr in cols] + ["recomputed_usd"]
    rows = []
    for r in raw:
        rec = dict(zip(names, r))
        if rec.get("id"):
            sid = str(rec["id"])
            rec["id"] = sid.split("-", 1)[-1][:10]  # short, still unique enough to cross-reference
        rc = recompute_cost(str(rec.get("model") or ""), rec)
        rows.append(tuple(rec[c] for c in names) + (rc,))
    return headers, rows


def format_sessions(cols: list[str], rows: list[tuple], as_csv: bool = False) -> str:
    """Render sessions as CSV or an aligned table with totals for Hermes' estimate and the recomputation."""
    def cell(c: str, v: object) -> str:
        if v is None:
            return ""
        if c in ("started",):
            d = _to_datetime(v)
            return d.strftime("%Y-%m-%d %H:%M") if d else str(v)
        if c.endswith("_usd") and _is_number(v):
            return f"{float(v):.4f}"
        return str(v)

    table = [[cell(c, v) for c, v in zip(cols, r)] for r in rows]
    if as_csv:
        buf = __import__("io").StringIO()
        w = csv.writer(buf)
        w.writerow(cols)
        w.writerows(table)
        return buf.getvalue().rstrip("\n")
    widths = [max([len(c)] + [len(r[i]) for r in table]) for i, c in enumerate(cols)]
    line = lambda vals: "  ".join(v.ljust(widths[i]) for i, v in enumerate(vals))
    out = [line(cols), line(["-" * w for w in widths])] + [line(r) for r in table]

    def total(col: str) -> float | None:
        if col not in cols:
            return None
        i = cols.index(col)
        vals = [float(r[i]) for r in rows if _is_number(r[i])]
        return sum(vals) if vals else None

    est, rec = total("hermes_est_usd"), total("recomputed_usd")
    summary = f"{len(rows)} sessions · Hermes estimate ${est or 0:.4f}"
    if rec is not None:
        summary += f" · recomputed from published prices ${rec:.4f}"
    out.append(summary)
    out.append("Both are estimates. Your provider's billing page is the source of truth.")
    return "\n".join(out)


def _is_number(value: object) -> bool:
    if value is None or isinstance(value, bool):
        return False
    try:
        float(value)  # type: ignore[arg-type]
        return True
    except (TypeError, ValueError):
        return False


def _to_datetime(value: object) -> dt.datetime | None:
    try:
        num = float(value)  # type: ignore[arg-type]
        return dt.datetime.fromtimestamp(num / 1000 if num > 1e12 else num)
    except (TypeError, ValueError, OverflowError, OSError):
        pass
    try:
        return dt.datetime.fromisoformat(str(value).replace("Z", "+00:00"))
    except ValueError:
        return None


# ================================================================ routing
@dataclass
class Decision:
    tier: str
    reason: str
    source: str  # classifier | heuristic | forced


def parse_reply(text: str) -> tuple[str, str] | None:
    """Extract (tier, reason) from a classifier reply containing JSON."""
    match = re.search(r"\{.*\}", text or "", re.DOTALL)
    if not match:
        return None
    try:
        parsed = json.loads(match.group(0))
    except json.JSONDecodeError:
        return None
    tier = str(parsed.get("tier", "")).strip().lower()
    return (tier, str(parsed.get("reason", "")).strip()) if tier in TIERS else None


def heuristic(task: str) -> tuple[str, str]:
    """Offline fallback: keywords and length."""
    if HEAVY.search(task):
        return "o", "heavy-work keyword"
    if len(task.split()) <= 25:
        return "q", "short question"
    return "s", "default"


def classifier_target(cfg: Config) -> tuple[Tier, dict, str] | None:
    """Pick the tier that runs classification: the configured one, else any tier with a usable API."""
    env_file = read_env_file()
    order = [cfg.classifier_tier] + [t for t in TIERS if t != cfg.classifier_tier]
    for key in order:
        tier = cfg.tiers[key]
        ep = cfg.endpoint(tier.provider)
        if not ep:
            continue
        k = get_key(ep, env_file)
        if k is not None:
            return tier, ep, k
    return None


def route(task: str, cfg: Config, forced: str | None = None, budget: Budget | None = None) -> Decision:
    """Decide the tier for a task."""
    if forced:
        return Decision(forced, "forced", "forced")
    target = classifier_target(cfg)
    if target:
        tier, ep, key = target
        hint = BUDGET_HINTS.get(budget.status, "") if budget else ""
        reply = chat(ep, key, tier.model, SYSTEM_PROMPT.format(budget_hint=hint), task[:4000])
        result = parse_reply(reply or "")
        if result:
            return Decision(result[0], result[1], "classifier")
        log.debug("Classifier unusable reply: %r", reply)
    tier_key, reason = heuristic(task)
    return Decision(tier_key, reason, "heuristic")


# ================================================================ check
def check(cfg: Config) -> list[str]:
    """Human-readable health report for each tier."""
    env_file = read_env_file()
    lines = [f"Config: {cfg.name}" + ("" if CONFIG_FILE.exists() else "  (built-in default; run h --init <preset>)")]
    for key in TIERS:
        t = cfg.tiers[key]
        head = f"  {key}  {t.name:<22} {t.provider}/{t.model}"
        ep = cfg.endpoint(t.provider)
        if not ep:
            lines.append(f"{head}\n      ? launch-only provider (subscription sign-in); h can't verify it, "
                         "check `hermes auth status " + t.provider + "`")
            continue
        k = get_key(ep, env_file)
        if k is None:
            lines.append(f"{head}\n      ✗ no key: set {' or '.join(ep['key_env'])} in ~/.hermes/.env")
            continue
        models = list_models(ep, k)
        if models is None:
            lines.append(f"{head}\n      ? key found, but couldn't list models (offline or endpoint differs)")
        elif t.model in models:
            lines.append(f"{head}\n      ✓ key found, model available")
        else:
            close = sorted(m for m in models if t.model.split("-")[0] in m)[:6]
            lines.append(f"{head}\n      ✗ model not offered by provider" +
                         (f"; similar: {', '.join(close)}" if close else ""))
    ct = classifier_target(cfg)
    lines.append(f"Classifier: {ct[0].provider}/{ct[0].model}" if ct else
                 "Classifier: none available; keyword heuristic only")
    return lines


# ================================================================ logging, stats, eval
def log_decision(task: str, d: Decision, cfg: Config, budget: Budget | None, path: Path = LOG_FILE) -> None:
    t = cfg.tiers[d.tier]
    entry = {"ts": dt.datetime.now().isoformat(timespec="seconds"), **asdict(d),
             "provider": t.provider, "model": t.model,
             "budget_status": budget.status if budget else "unknown", "words": len(task.split())}
    if os.environ.get("H_LOG_TASKS", "1") != "0":
        entry["task"] = task[:80]
    try:
        path.parent.mkdir(parents=True, exist_ok=True)
        with path.open("a") as fh:
            fh.write(json.dumps(entry) + "\n")
    except OSError as exc:
        log.debug("Could not write routing log: %s", exc)


def stats(path: Path = LOG_FILE, days: int = 30) -> str:
    if not path.exists():
        return "No routing decisions logged yet."
    cutoff = dt.datetime.now() - dt.timedelta(days=days)
    tiers: dict[str, int] = {}
    sources: dict[str, int] = {}
    models: dict[str, int] = {}
    total = 0
    for line in path.read_text().splitlines():
        try:
            e = json.loads(line)
            if dt.datetime.fromisoformat(e["ts"]) < cutoff:
                continue
        except (json.JSONDecodeError, KeyError, ValueError):
            continue
        total += 1
        tiers[e["tier"]] = tiers.get(e["tier"], 0) + 1
        sources[e["source"]] = sources.get(e["source"], 0) + 1
        m = f"{e.get('provider', '?')}/{e.get('model', '?')}"
        models[m] = models.get(m, 0) + 1
    if not total:
        return f"No routing decisions in the last {days} days."
    out = [f"Last {days} days: {total} sessions routed"]
    for t in TIERS:
        n = tiers.get(t, 0)
        out.append(f"  {TIER_NAMES[t]:<9}{n:>4}  {'█' * round(20 * n / total)}")
    out.append("  models:  " + ", ".join(f"{k} {v}" for k, v in sorted(models.items(), key=lambda x: -x[1])))
    out.append("  sources: " + ", ".join(f"{k} {v}" for k, v in sorted(sources.items())))
    if sources.get("heuristic", 0) > 0.2 * total:
        out.append("  ⚠ many heuristic fallbacks: classifier calls are failing (run h --check)")
    return "\n".join(out)


def run_eval(cfg: Config, task_file: Path, out=sys.stdout) -> None:
    budget = read_budget(cfg)
    writer = csv.writer(out)
    writer.writerow(["task", "tier", "reason", "source", "expected"])
    for line in task_file.read_text().splitlines():
        task = line.strip()
        if task and not task.startswith("#"):
            d = route(task, cfg, budget=budget)
            writer.writerow([task, d.tier, d.reason, d.source, ""])


def score(csv_file: Path) -> str:
    rows = [r for r in csv.DictReader(csv_file.open()) if r.get("expected", "").strip()]
    if not rows:
        return "No labelled rows: fill the 'expected' column with q, s or o."
    order = {"q": 0, "s": 1, "o": 2}
    exact = sum(r["tier"] == r["expected"].strip() for r in rows)
    under = sum(order[r["tier"]] < order[r["expected"].strip()] for r in rows)
    over = len(rows) - exact - under
    return (f"{len(rows)} labelled tasks: {exact} exact ({100 * exact / len(rows):.0f}%), "
            f"{under} under-routed (quality risk), {over} over-routed (cost waste)")


# ================================================================ launch
def copy_to_clipboard(text: str) -> bool:
    for cmd in (["pbcopy"], ["wl-copy"], ["xclip", "-selection", "clipboard"]):
        if shutil.which(cmd[0]):
            try:
                subprocess.run(cmd, input=text.encode(), check=True)
                return True
            except subprocess.CalledProcessError:
                continue
    return False


def build_args(task: str, tier: Tier) -> list[str]:
    """hermes chat argv. Task goes in via -q (Hermes v0.23+: seeds an interactive session on a TTY).
    H_FIRST_MESSAGE_FLAG=clipboard restores the old copy-and-paste behaviour for older Hermes."""
    args = ["hermes", "chat", "--provider", tier.provider, "--model", tier.model]
    if tier.reasoning:
        args += ["--reasoning", tier.reasoning]
    flag = os.environ.get("H_FIRST_MESSAGE_FLAG", "-q").strip()
    if flag and flag.lower() != "clipboard":
        args += [flag, task]
    return args


def launch(task: str, tier: Tier) -> int:
    if shutil.which("hermes") is None:
        print("h: 'hermes' not found on PATH", file=sys.stderr)
        return 1
    args = build_args(task, tier)
    if task not in args:  # clipboard mode for Hermes builds without -q
        if copy_to_clipboard(task):
            print("  Task copied: paste it (⌘V / Ctrl+Shift+V) as your first message.")
        else:
            print(f"  First message: {task}")
    sys.stdout.flush()
    time.sleep(float(os.environ.get("H_PAUSE", "1.5")))
    os.execvp(args[0], args)
    return 0  # unreachable


def init(preset: str | None) -> int:
    presets = find_presets()
    if not preset or preset not in presets:
        print("Presets: " + (", ".join(presets) or "none found next to h"), file=sys.stderr)
        print("Usage: h --init <preset>", file=sys.stderr)
        return 2
    if CONFIG_FILE.exists():
        backup = CONFIG_FILE.with_suffix(".json.bak")
        shutil.copy2(CONFIG_FILE, backup)
        print(f"Backed up existing config to {backup}")
    CONFIG_FILE.parent.mkdir(parents=True, exist_ok=True)
    raw = json.loads(presets[preset].read_text())
    raw["name"] = preset
    CONFIG_FILE.write_text(json.dumps(raw, indent=2) + "\n")
    todo = [k for k, t in raw["tiers"].items() if "REPLACE" in str(t.get("model", "")).upper()]
    nxt = (f"edit the placeholder model for tier(s) {', '.join(todo)} in {CONFIG_FILE}, then run h --check"
           if todo else "run h --check")
    print(f"Wrote {CONFIG_FILE} from preset '{preset}'. Next: {nxt}")
    return 0


def main(argv: list[str]) -> int:
    logging.basicConfig(level=logging.DEBUG if os.environ.get("H_DEBUG") else logging.WARNING,
                        format="h: %(message)s")
    cmd = argv[0] if argv else ""
    if cmd in ("-h", "--help"):
        print(__doc__)
        return 0
    if cmd == "--version":
        print(f"h {__version__}")
        return 0
    if cmd == "--presets":
        for name, path in find_presets().items():
            desc = json.loads(path.read_text()).get("description", "")
            print(f"  {name:<16} {desc}")
        return 0
    if cmd == "--init":
        return init(argv[1] if len(argv) > 1 else None)
    if cmd == "--stats":
        print(stats())
        return 0
    if cmd == "--sessions":
        rest = argv[1:]
        if "--schema" in rest:
            con = sqlite3.connect(f"file:{STATE_DB}?mode=ro", uri=True, timeout=2)
            for r in con.execute("PRAGMA table_info(sessions)"):
                print(f"  {r[1]:<32} {r[2]}")
            con.close()
            return 0
        n = next((int(a) for a in rest if a.isdigit()), 10)
        cols, rows = read_sessions(limit=n, titles="--titles" in rest)
        print(format_sessions(cols, rows, as_csv="--csv" in rest))
        return 0

    cfg = load_config()
    if cmd == "--check":
        print("\n".join(check(cfg)))
        return 0
    if cmd == "--budget":
        b = read_budget(cfg)
        print(b.line() if b else "Budget unavailable (no budget_usd set, or no readable state.db). H_DEBUG=1 for details.")
        return 0
    if cmd in ("--eval", "--score"):
        if len(argv) < 2:
            print(f"h: {cmd} needs a file", file=sys.stderr)
            return 2
        if cmd == "--eval":
            run_eval(cfg, Path(argv[1]))
        else:
            print(score(Path(argv[1])))
        return 0

    dry_run = cmd == "-n"
    if dry_run:
        argv = argv[1:]
    forced = argv.pop(0)[1] if argv and argv[0] in ("-q", "-s", "-o") else None
    task = " ".join(argv).strip()
    if not task:
        try:
            task = input("Task: ").strip()
        except (EOFError, KeyboardInterrupt):
            return 1
    if not task:
        print("h: no task given", file=sys.stderr)
        return 1

    budget = read_budget(cfg)
    d = route(task, cfg, forced, budget)
    tier = cfg.tiers[d.tier]
    tag = "" if d.source == "classifier" else f" [{d.source}]"
    effort = f", reasoning {tier.reasoning}" if tier.reasoning else ""
    print(f"→ {tier.name} ({tier.provider}/{tier.model}{effort}): {d.reason}{tag}")
    if budget:
        print(f"  {budget.line()}")
    if dry_run:
        return 0
    log_decision(task, d, cfg, budget)
    return launch(task, tier)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
